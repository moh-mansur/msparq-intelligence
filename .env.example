# Postgres connection for the school database (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://user:password@host:6543/postgres

# Shared secret the school app sends as "Authorization: Bearer <key>".
# Required: without it every /predictions route answers 503.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the same value as INTELLIGENCE_API_KEY in the school app.
INTELLIGENCE_API_KEY=

# The school app's origin, for CORS.
MSPARQ_APP_URL=http://localhost:3000
